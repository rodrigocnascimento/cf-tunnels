FROM docker.io/library/node:24-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates curl dbus jq sudo systemd systemd-sysv util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && printf 'node ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/cftunnel-smoke \
    && chmod 440 /etc/sudoers.d/cftunnel-smoke

ENV TERM=xterm-256color
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
